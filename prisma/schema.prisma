generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Airdrop {
  id                 Int         @id @default(autoincrement())
  date               String
  token              String
  amount             Float
  currentPrice       String?
  points             Int?
  phase1Points       Int?
  phase2Points       Int?
  startTime          String?
  endTime            String?
  phase1EndTime      String?
  phase2EndTime      String?
  supplementaryToken Float
  participants       Int?
  type               AirdropType
  cost               Float?
  pointsConsumed     Boolean     @default(true)
  description        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("airdrops")
}

enum AirdropType {
  airdrop
  tge
  preTge
  bondingCurveTge
}
